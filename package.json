{
  "name": "art-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "npm --prefix server run dev",
    "backend:start": "npm --prefix server start",
    "backend:test": "npm --prefix server test",
    "backend:seed": "npm --prefix server run seed",
    "backend:admin": "npm --prefix server run create-admin",
    "frontend": "npm --prefix client run dev",
    "frontend:build": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
